# SITE_ADDRESS comes from deploy/.env
#   ornek.com, www.ornek.com -> HTTPS for your domain; www is redirected to ornek.com
#   1-2-3-4.sslip.io         -> automatic HTTPS without buying a domain (IP with dashes)
#   :80                      -> plain HTTP (no certificate)
{$SITE_ADDRESS::80} {
	# one canonical address for search engines: www.ornek.com -> ornek.com
	@www header_regexp www Host ^www\.(.+)$
	redir @www https://{re.www.1}{uri} 308

	encode gzip

	request_body {
		max_size 64KB
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}

	reverse_proxy api:8000
}
