# ---- Address -------------------------------------------------------------
# With your own domain (DNS A records for @ and www pointing to the server):
#   SITE_ADDRESS=ornek.com, www.ornek.com
# Without a domain: <ip-with-dashes>.sslip.io (the Oracle script fills this in)
# Plain HTTP: :80
SITE_ADDRESS=:80

# Shown on the legal pages and as the copyright/takedown contact (required for a public site)
CONTACT_EMAIL=

# ---- Bot protection (Cloudflare Turnstile, free) -------------------------
# dash.cloudflare.com > Turnstile > Add widget (hostname = your domain).
# Leave empty to turn it off.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- YouTube --------------------------------------------------------------
# Datacenter IPs get "Sign in to confirm you're not a bot"; YouTube traffic goes
# through the WARP container. Leave empty to connect directly.
YOUTUBE_PROXY=http://warp:1080
# Last resort: cookies.txt (Netscape format) of a THROWAWAY Google account,
# placed in deploy/cookies/. Never use your main account; it can get banned.
# YOUTUBE_COOKIES_FILE=/cookies/youtube.txt

# Other sites connect directly. Set a proxy here only if one of them blocks the server.
OTHER_PROXY=

# ---- Limits ---------------------------------------------------------------
MAX_CONCURRENT_JOBS=2
MAX_QUEUE=20
MAX_DURATION_SEC=900
MAX_SUBTITLE_DURATION_SEC=300
MAX_FILESIZE_MB=500
FILE_TTL_MIN=60
RATE_LIMIT_PER_HOUR=15

# Whisper on a 2-4 core ARM CPU is slow; turn the subtitle studio off if the server struggles
ALLOW_SUBTITLES=1

# ---- Maintenance ----------------------------------------------------------
# Update yt-dlp on every container start (nightly follows YouTube changes fastest)
AUTO_UPDATE_YTDLP=1
YTDLP_CHANNEL=nightly
# How often the server test-downloads a short YouTube video (seconds)
HEALTH_INTERVAL_SEC=3600
DESKTOP_APP_URL=https://github.com/Oguzhan61-dilmac/media-downloader-hub
